{
  "name": "integration_jupyterhub",
  "description": "Integrate JupyterHub into Nextcloud",
  "version": "0.2.8",
  "author": "Micke Nordin <kano@sunet.se>",
  "bugs": {
    "url": "https://github.com/SUNET/nextcloud-jupyter/issues"
  },
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --stats=errors-warnings",
    "dev": "NODE_ENV=development webpack --progress --config webpack.config.js",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.config.js",
    "lint": "eslint src 'tests/**/*.js'",
    "lint:fix": "eslint src 'tests/**/*.js' --fix",
    "test": "vitest run",
    "stylelint": "stylelint 'src/**/*.vue'",
    "stylelint:fix": "stylelint 'src/**/*.vue' --fix"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/files": "^4.1.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43",
    "vue-material-design-icons": "^5.4.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10.5.0"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "eslint": "^10.12.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "vitest": "^5.0.4"
  }
}
