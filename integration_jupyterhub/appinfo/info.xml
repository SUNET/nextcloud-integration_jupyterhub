  <id>integration_jupyterhub</id>
  <name>JupyterHub Integration</name>
  <summary>Integrate JupyterHub into Nextcloud</summary>
  <description>
    <![CDATA[Integrate JupyterHub into Nextcloud]]>
  </description>
  <version>0.2.2</version>
  <licence>agpl</licence>
  <author mail="kano@sunet.se" homepage="https://github.com/SUNET/nextcloud-jupyter">Mikael Nordin</author>
  <namespace>Jupyter</namespace>
  <category>integration</category>
  <bugs>https://github.com/SUNET/nextcloud-jupyter/issues</bugs>
  <dependencies>
    <nextcloud min-version="28" max-version="35" />
  </dependencies>
  <repair-steps>
    <post-migration>
      <step>OCA\Jupyter\Repair\RegisterFilesMetadata</step>
    </post-migration>
    <install>
      <step>OCA\Jupyter\Repair\RegisterFilesMetadata</step>
    </install>
  </repair-steps>
  <commands>
    <command>OCA\Jupyter\Commands\GetUrl</command>
    <command>OCA\Jupyter\Commands\SetUrl</command>
  </commands>
  <settings>
    <admin>OCA\Jupyter\Settings\AdminSettings</admin>
  </settings>
  <navigations>
    <navigation>
      <name>Jupyter</name>
      <route>integration_jupyterhub.page.index</route>
    </navigation>
  </navigations>
</info>
