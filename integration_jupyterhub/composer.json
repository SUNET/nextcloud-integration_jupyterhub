{
  "name": "sunet/integration_jupyterhub",
  "description": "Integrate JupyterHub into Nextcloud",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "autoload": {
    "psr-4": {
      "OCA\\Jupyter\\": "lib/"
    }
  },
  "authors": [
    {
      "name": "Micke Nordin",
      "email": "kano@sunet.se"
    }
  ],
  "require-dev": {
    "nextcloud/coding-standard": "^1.0"
  },
  "scripts": {
    "lint": "find . -name \\*.php -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
